---
layout: default
---
<div class="post">
  <div class="header-bar">
    <h1><i class="fa-solid fa-hashtag fa-sm"></i> {{ page.title }}</h1>
    <h2>
      {{ page.posts.size }} post{% if page.posts.size != 1 %}s{% endif %} with this tag
    </h2>
  </div>

  <div class="blog-filters">
    <a class="blog-filter" href="{{ '/blog/' | relative_url }}">all</a>
  </div>

  {% include blog_grid.liquid posts=page.posts %}
</div>
