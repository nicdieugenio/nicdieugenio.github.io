---
layout: default
---
<div class="post">
  <div class="header-bar">
    <h1><i class="fa-solid fa-tag fa-sm"></i> {{ page.title }}</h1>
    <h2>
      {{ page.posts.size }} post{% if page.posts.size != 1 %}s{% endif %} in this category
    </h2>
  </div>

  <div class="blog-filters">
    <a class="blog-filter" href="{{ '/blog/' | relative_url }}">all</a>
    {% for category in site.display_categories %}
      {% if site.categories[category].size > 0 %}
        {% assign cat_slug = category | slugify %}
        {% assign page_slug = page.title | slugify %}
        <a class="blog-filter{% if cat_slug == page_slug %} active{% endif %}" href="{{ cat_slug | prepend: '/blog/category/' | relative_url }}">
          {{- category -}}
        </a>
      {% endif %}
    {% endfor %}
  </div>

  {% include blog_grid.liquid posts=page.posts %}
</div>
